APP_NAME=resume-intelligence
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

DATABASE_URL=postgresql+asyncpg://resume:resume@postgres:5432/resume_ai
SYNC_DATABASE_URL=postgresql+psycopg://resume:resume@postgres:5432/resume_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_DEV_BYPASS=false

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=candidate_embeddings
QDRANT_JOB_COLLECTION=job_description_embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384
MLFLOW_TRACKING_URI=http://mlflow:5000

# LLM Configuration - Gemini Only (OpenAI deprecated)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
RATE_LIMIT_DEFAULT=100/minute
MAX_UPLOAD_BYTES=10485760
MATCH_SEMANTIC_WEIGHT=0.40
MATCH_SKILL_WEIGHT=0.25
MATCH_EXPERIENCE_WEIGHT=0.15
MATCH_EDUCATION_WEIGHT=0.10
MATCH_KEYWORD_WEIGHT=0.10
