# Copy this file to .env for local development.
# Never commit real secrets. Generate production secrets with a secure password manager
# or a command such as: openssl rand -hex 32

# ==================================================
# APP
# ==================================================
APP_NAME=resume-intelligence
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_DEFAULT=100/minute

# ==================================================
# DATABASE
# ==================================================
DATABASE_URL=postgresql+asyncpg://resume:resume@localhost:5432/resume_ai
SYNC_DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume_ai
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_ai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000
DB_READ_REPLICA_URL=

# ==================================================
# REDIS
# ==================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
REDIS_STREAM_RESUME_EVENTS=resume-events
REDIS_STREAM_AI_EVENTS=ai-events
REDIS_STREAM_WORKFLOW_EVENTS=workflow-events
REDIS_CONSUMER_GROUP=resume-intelligence-workers
REDIS_PUBSUB_CHANNEL=realtime-updates
REDIS_MAX_CONNECTIONS=50

# ==================================================
# GEMINI AI
# ==================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2

# ==================================================
# VECTOR DATABASE
# ==================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=candidate_embeddings
QDRANT_JOB_COLLECTION=job_description_embeddings
QDRANT_MEMORY_COLLECTION=recruiter_memory_embeddings
QDRANT_RECOMMENDATION_COLLECTION=recommendation_embeddings
QDRANT_TIMEOUT_SECONDS=20
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384
EMBEDDING_BATCH_SIZE=32

# ==================================================
# STORAGE
# ==================================================
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CONSOLE_URL=http://localhost:9001

# ==================================================
# SECURITY
# ==================================================
JWT_SECRET_KEY=change-me-use-a-32-byte-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_DEV_BYPASS=false
API_KEY_PEPPER=change-me-api-key-pepper
ENCRYPTION_KEY=change-me-32-byte-base64-key
PROMPT_INJECTION_DEFENSE_ENABLED=true
PII_MASKING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# ==================================================
# OBSERVABILITY
# ==================================================
MLFLOW_TRACKING_URI=http://localhost:5000
PREFECT_API_URL=http://localhost:4200/api
OTEL_SERVICE_NAME=resume-intelligence-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100
AI_METRICS_ENABLED=true
LOG_JSON=true

# ==================================================
# BILLING
# ==================================================
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_ENTERPRISE=price_enterprise
BILLING_PORTAL_BASE_URL=https://billing.stripe.com
FREE_MONTHLY_RESUME_LIMIT=250
PRO_MONTHLY_RESUME_LIMIT=5000
ENTERPRISE_MONTHLY_RESUME_LIMIT=100000
FREE_MONTHLY_LLM_TOKEN_LIMIT=100000
PRO_MONTHLY_LLM_TOKEN_LIMIT=2000000
ENTERPRISE_MONTHLY_LLM_TOKEN_LIMIT=50000000
FREE_MONTHLY_VECTOR_QUERY_LIMIT=2000
PRO_MONTHLY_VECTOR_QUERY_LIMIT=75000
ENTERPRISE_MONTHLY_VECTOR_QUERY_LIMIT=2000000

# ==================================================
# ANALYTICS
# ==================================================
ANALYTICS_ENABLED=true
ANALYTICS_SNAPSHOT_CRON=0 * * * *
RECRUITER_SATISFACTION_METRIC_ENABLED=true
RANKING_DRIFT_THRESHOLD=0.15
RECOMMENDATION_QUALITY_THRESHOLD=0.72

# ==================================================
# FEATURE FLAGS
# ==================================================
FEATURE_COPILOT_2=true
FEATURE_RECOMMENDATIONS=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_ADAPTIVE_RETRIEVAL=true
FEATURE_BILLING=true
FEATURE_LIVE_COLLABORATION=true
FEATURE_AI_SAFETY=true
FEATURE_DEMO_MODE=true

# ==================================================
# KNOWLEDGE GRAPH
# ==================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=resume-graph-password
NEO4J_DATABASE=neo4j
SKILL_GRAPH_REFRESH_INTERVAL_SECONDS=3600

# ==================================================
# AI SAFETY
# ==================================================
AI_SAFETY_ENABLED=true
HALLUCINATION_CHECK_ENABLED=true
GROUNDING_CHECK_ENABLED=true
UNSAFE_OUTPUT_DETECTION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_MIN_CONFIDENCE=0.45

# ==================================================
# RECOMMENDATION ENGINE
# ==================================================
RECOMMENDATION_ENGINE_ENABLED=true
RECOMMENDATION_GRAPH_MIN_SIMILARITY=0.35
RECOMMENDATION_MAX_CANDIDATES=500
RECRUITER_MEMORY_ENABLED=true
RECRUITER_MEMORY_TTL_SECONDS=2592000
PERSONALIZATION_MIN_FEEDBACK_EVENTS=5

# ==================================================
# WEBSOCKET SCALING
# ==================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_REDIS_CHANNEL=realtime-updates
WEBSOCKET_HEARTBEAT_SECONDS=30
WEBSOCKET_MAX_CONNECTIONS_PER_ORG=250
