ENVIRONMENT=local
APP_NAME=resume-intelligence
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://resume:resume@postgres:5432/resume_ai
SYNC_DATABASE_URL=postgresql://resume:resume@postgres:5432/resume_ai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_ISSUER=https://example.clerk.accounts.dev
JWT_AUDIENCE=resume-intelligence-api
JWT_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
AUTH_DEV_BYPASS=true

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1

QDRANT_URL=http://qdrant:6333
MLFLOW_TRACKING_URI=http://mlflow:5000
OPENAI_API_KEY=
