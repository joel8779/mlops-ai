# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Deployment)
# ==============================================================================

# Next.js API endpoint pointing to the Railway production backend API
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1

# Clerk Authentication (Production Publishable Key)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ==============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Railway Deployment - FastAPI Service)
# ==============================================================================

# Core App Settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Database - Neon Serverless PostgreSQL Connection Pool URL
# (Use pooled connection -pgpool- to prevent database connection exhaustion)
DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_host>-pooler.us-east-2.aws.neon.tech/neondb

# Redis Cache - Upstash Serverless SSL Redis URL (Db 0)
REDIS_URL=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/0

# Celery Message Broker - Upstash Serverless SSL Redis URL (Db 1 for queue isolation)
CELERY_BROKER_URL=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/1

# Celery Result Backend - Upstash Serverless SSL Redis URL (Db 2 for result isolation)
CELERY_RESULT_BACKEND=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/2

# Vector Search - Qdrant Cloud
QDRANT_URL=https://<qdrant_cluster_id>.aws.qdrant.io:6333
QDRANT_API_KEY=<qdrant_api_key>
QDRANT_COLLECTION=candidate_embeddings
QDRANT_JOB_COLLECTION=job_description_embeddings

# LLM Provider - Google Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Object Storage - Cloudflare R2
S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<cloudflare_r2_access_key_id>
S3_SECRET_ACCESS_KEY=<cloudflare_r2_secret_access_key>
S3_BUCKET=resumes-prod
S3_REGION=us-east-1

# SMTP Email Configuration (Real SMTP Server, e.g. Sendgrid / Mailgun)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=465
SMTP_USERNAME=apikey
SMTP_PASSWORD=<sendgrid_api_key>
SMTP_FROM_EMAIL=recruiter@yourdomain.com
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10

# Security (JWT Secrets - MUST generate secure 64-character hex keys)
JWT_SECRET_KEY=<secure_random_hex_key_64_chars>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / Origin Settings
BACKEND_CORS_ORIGINS=["https://web.yourdomain.com"]
FRONTEND_URL=https://web.yourdomain.com


# ==============================================================================
# 3. WORKER ENVIRONMENT VARIABLES (Railway Deployment - Celery Service)
# ==============================================================================

# Core App Settings (Matches API config)
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Database - Neon Serverless PostgreSQL Direct URL
# (Workers do not need pooled connections and perform direct transactions)
DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_host>.us-east-2.aws.neon.tech/neondb
SYNC_DATABASE_URL=postgresql+psycopg://<neon_user>:<neon_password>@<neon_host>.us-east-2.aws.neon.tech/neondb

# Redis / Celery Connection (Matches API config)
REDIS_URL=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/0
CELERY_BROKER_URL=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/2

# Vector Search - Qdrant Cloud (Matches API config)
QDRANT_URL=https://<qdrant_cluster_id>.aws.qdrant.io:6333
QDRANT_API_KEY=<qdrant_api_key>
QDRANT_COLLECTION=candidate_embeddings
QDRANT_JOB_COLLECTION=job_description_embeddings

# LLM Provider - Google Gemini (Matches API config)
LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Object Storage - Cloudflare R2 (Matches API config)
S3_ENDPOINT_URL=https://<cloudflare_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<cloudflare_r2_access_key_id>
S3_SECRET_ACCESS_KEY=<cloudflare_r2_secret_access_key>
S3_BUCKET=resumes-prod
S3_REGION=us-east-1
