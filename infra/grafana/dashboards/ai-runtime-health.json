{
  "title": "AI Runtime Health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "LLM Latency p95",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(llm_request_latency_ms_bucket[5m])) by (le, model, feature))", "legendFormat": "{{model}} / {{feature}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Failures",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(increase(llm_failures_total[5m])) by (model, feature, error_type)", "legendFormat": "{{model}} / {{feature}} / {{error_type}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Estimated LLM Cost",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(increase(llm_estimated_cost_usd[1h])) by (model, feature)", "legendFormat": "{{model}} / {{feature}}"}
      ]
    }
  ]
}
