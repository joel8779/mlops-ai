{
  "title": "RAG Quality",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Retrieval Latency p95",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(retrieval_topk_latency_ms_bucket[5m])) by (le, strategy))", "legendFormat": "{{strategy}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval Confidence",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "avg_over_time(retrieval_confidence_sum[5m]) / avg_over_time(retrieval_confidence_count[5m])", "legendFormat": "confidence"}
      ]
    }
  ]
}
