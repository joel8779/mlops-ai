# ==============================================================================
# Production Environment Configuration
# ==============================================================================

# Core App settings
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# Database - Neon Serverless PostgreSQL URLs
# (use pooled connection for API, direct for migrations)
DATABASE_URL=postgresql+asyncpg://<neon_user>:<neon_password>@<neon_host>-pooler.us-east-2.aws.neon.tech/neondb
SYNC_DATABASE_URL=postgresql+psycopg://<neon_user>:<neon_password>@<neon_host>.us-east-2.aws.neon.tech/neondb

# Redis - Upstash Serverless SSL Redis URLs
REDIS_URL=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/0
CELERY_BROKER_URL=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/1
CELERY_RESULT_BACKEND=rediss://default:<upstash_password>@<upstash_host>.upstash.io:6379/2

# Vector Search - Qdrant Cloud
QDRANT_URL=https://<qdrant_cluster_id>.aws.qdrant.io:6333
QDRANT_API_KEY=<qdrant_api_key>

# Gemini LLM Provider
GEMINI_API_KEY=<gemini_api_key>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Authentication (JWT Secret key must be randomly generated secure string)
JWT_SECRET_KEY=<generate_secure_random_key_64_chars>
JWT_ALGORITHM=HS256

# Object Storage (S3 / Cloudflare R2 / AWS S3)
S3_ENDPOINT_URL=https://<r2_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<s3_access_key>
S3_SECRET_ACCESS_KEY=<s3_secret_key>
S3_BUCKET=resumes-production
S3_REGION=us-east-1

# SMTP Configuration (Production SMTP Relay)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=465
SMTP_USERNAME=apikey
SMTP_PASSWORD=<sendgrid_api_key>
SMTP_FROM_EMAIL=recruiter@yourdomain.com
SMTP_USE_TLS=false

# CORS Configuration
BACKEND_CORS_ORIGINS=["https://web.yourdomain.com"]
FRONTEND_URL=https://web.yourdomain.com
